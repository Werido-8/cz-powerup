@startuml
start

partition "普通员工" {
  :在知识总览 / 我的空间 / 我的上传中\n点击文档;
}

partition "系统" {
  :默认新开浏览器 Tab;
  :进入文件详情页;
}

partition "文件详情页" {
  :展示当前知识库文件列表（左侧）;
  :展示文档预览区（中间）;
  :展示文件名、所属知识库、解析状态;

  if (文档是否已发布?) then (是)
    :在线预览文档原文;
  else (解析中 / 解析失败 / 待审批等)
    :展示对应状态提示;
    note right
      解析未完成前
      不支持正文内容检索
    end note
  endif

  partition "普通员工" {
    if (用户操作?) then (库内切换文档)
      :在左侧列表选择同库其他文件;
      :切换预览内容;
      note right
        仅支持当前知识库内切换
        不做跨库复杂切换
      end note
    elseif (下载) then
      :下载文档到本地;
    elseif (收藏 / 取消收藏) then
      :更新收藏状态;
    elseif (查看历史版本) then
      :查看文档已有历史版本;
      note right
        主列表不展开多版本子表格
        一期不做版本差异对比
      end note
    elseif (跨库查找其他文档) then
      :返回知识总览;
      :重新选择知识库或全部范围检索;
      stop
    endif
  }
}

note bottom
  普通员工在详情页仅具备
  预览、下载、收藏、查看历史版本等能力
  不具备编辑、删除已发布库内文档的权限
end note

stop
@enduml
