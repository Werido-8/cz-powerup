@startuml
start

if (授权发起方式?) then (员工申请)
  partition "普通员工" {
    :浏览知识库树;
    :点击无权限或权限不足的知识库;
    :查看知识库基础信息;
    note right
      可见无权限知识库
      但不可查看库内文档
    end note
    :点击申请权限;
    :填写申请理由;
    :提交申请;
  }

  partition "系统" {
    :生成权限申请记录;
    :通知知识库管理员;
  }

  partition "知识库管理员" {
    :查看权限申请;
    if (是否同意?) then (同意)
      :审批通过并授予对应权限级别;
      note right
        权限级别（知识库维度）：
        · 仅查看：预览 / 下载
        · 可上传：查看 + 向库内提交上传
        · 可管理：管理库内文档等
      end note
    else (驳回)
      :填写驳回原因;
    endif
  }

  partition "系统" {
    if (审批结果?) then (通过)
      :更新个人授权;
      :合并计算最终可访问范围;
      :通知申请人已开通权限;
    else (驳回)
      :通知申请人已驳回;
      :展示驳回原因;
      :本次申请流程结束;
    endif
  }

else (管理员预授权)
  partition "知识库管理员" {
    :进入知识库管理;
    :选择目标知识库;
    if (授权方式?) then (角色授权)
      :将知识库授权给指定角色;
      note right
        角色下用户自动获得访问能力
        避免逐人配置
      end note
    else (个人授权)
      :将知识库直接授权给指定用户;
      note right
        用于个别申请通过
        或特殊场景
      end note
    endif
  }

  partition "系统" {
    :保存权限配置;
    :同步权限生效;
    :合并角色授权 + 个人授权;
    note right
      用户最终可访问范围
      = 角色授权范围 + 个人授权范围
    end note
  }
endif

stop
@enduml
